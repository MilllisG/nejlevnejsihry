# Public site URL used for Stripe redirect URLs
NEXT_PUBLIC_SITE_URL=https://nejlevnejsihry.link

# Stripe. Leave STRIPE_MOCK_MODE=true until you have real keys.
STRIPE_MOCK_MODE=true
STRIPE_SECRET_KEY=sk_test_replace_me
STRIPE_WEBHOOK_SECRET=whsec_replace_me

# Kinguin / distributor mode.
# mock = demo key only, live = call KINGUIN_ORDER_ENDPOINT.
KINGUIN_MODE=mock
KINGUIN_ORDER_ENDPOINT=https://api.example.com/orders
KINGUIN_API_TOKEN=replace_me

# Optional future database URL if you later connect Netlify Database/Postgres.
DATABASE_URL=

# Optional Discord links
